<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__APP_ROOT__/dist/server/server/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__APP_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>LLM_PROXY_CONFIG</key>
    <string>__CONFIG_PATH__</string>
    <key>LLM_PROXY_HOME</key>
    <string>__RUNTIME_HOME__</string>
    <key>LLM_PROXY_ENV</key>
    <string>__ENV_PATH__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__RUNTIME_HOME__/manager.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__RUNTIME_HOME__/manager.stderr.log</string>
</dict>
</plist>
